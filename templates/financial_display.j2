'YTD':'年初至今累计', 'single_quarter':'单季', 'annual':'年度', 'unknown':'未知',
'weighted_roe':'加权ROE', 'gross_margin':'销售毛利率', 'operating_revenue_yoy':'营业收入同比', 'total_operating_revenue_yoy':'营业总收入同比', 'parent_net_profit_yoy':'归母净利同比',
