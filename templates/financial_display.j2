'source_error':'本次数据查询未成功', 'authentication_failed':'登录验证未通过', 'permission_denied':'当前权限未覆盖此项数据', 'quota_exhausted':'数据调用额度受限', 'rate_limited':'数据接口临时限流', 'timeout':'数据查询超时', 'sdk_unavailable':'数据连接尚未就绪',
