} %}
{% macro label(code) -%}
{{ LABELS.get(code, code) }}
{%- endmacro %}
{% macro reasons(codes) -%}
{% for code in codes %}{{ label(code) }}{{ '；' if not loop.last else '' }}{% endfor %}
{%- endmacro %}
{% macro failure(code) -%}
{%- set parts = code.split(':') -%}
{%- if parts|length in [2, 3] and parts[0] in ['choice', 'ifind'] and parts[-1] in LABELS -%}
{{ {'choice':'Choice', 'ifind':'iFinD'}[parts[0]] }}{% if parts|length == 3 %}（{{ {'industry':'行业资料', 'company':'公司资料', 'targets':'机构目标价', 'balance_sheet':'资产负债', 'holders':'股东资料'}.get(parts[1], parts[1]) }}）{% endif %}：{{ label(parts[-1]) }}
{%- else -%}{{ label(code) }}{%- endif -%}
{%- endmacro %}
{% macro value(reading) -%}
{% if not reading %}尚未取得{% elif reading.unit == 'currency_base' %}{{ '%.2f'|format(reading.value / 100000000) }} 亿{{ '元' if reading.currency == 'CNY' else '（' ~ label(reading.currency or 'unknown') ~ '）' }}{% elif reading.unit == 'percentage_point' %}{{ '%.2f'|format(reading.value) }}%{% elif reading.unit == 'multiple' %}{{ '%.2f'|format(reading.value) }} 倍{% else %}{{ reading.value }}{% endif %}
{%- endmacro %}
