'single_family':'仅有同一来源家族', 'family_unknown':'来源独立性未明确', 'validation_disabled':'本次未启用独立核验', 'numeric_conflict':'数值差异超出核验范围',
'unit_unknown':'单位未知', 'unit_incompatible':'单位与指标不匹配', 'unit_mismatch':'单位不同', 'unit_conflict':'原始单位含义冲突', 'currency_unknown':'币种未知', 'currency_mismatch':'币种不同',
'roe_method_unknown':'ROE计算口径未知', 'pb_method_unknown':'PB计算口径未知', 'pe_not_ttm':'PE不是TTM口径', 'revenue_definition_unknown':'营收同比定义未知', 'profit_definition_unknown':'净利同比定义未知',
